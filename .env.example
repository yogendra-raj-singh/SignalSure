# GEMINI_API_KEY: Required for live Gemini AI scam analysis and Safety Assistant Q&A.
# AI Studio automatically injects this at runtime from user secrets.
# Leave unset to run SignalSure in clearly labelled Demo Mode.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional Integrations (configure on server / environment before enabling live connectors)
# Botpress Webchat v2 integration
BOTPRESS_BOT_ID=""
BOTPRESS_CLIENT_ID=""

# Incident reporting & workflow connectors (server-side HTTPS webhooks)
GOOGLE_SHEETS_WEBHOOK_URL=""
ZAPIER_INCIDENT_WEBHOOK_URL=""
GMAIL_ALERT_WEBHOOK_URL=""
LOOKER_STUDIO_REPORT_URL=""
